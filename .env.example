PORT=3000
# Real multiuser chat requires a persistent, backed-up single-instance volume.
# CRYPTOCHAT_DATA_FILE=/data/crypto-chat.json
# PUBLIC_BASE_URL=https://your-owned-https-domain.example
#
# Optional non-investment, platform-membership payments via Stripe hosted Checkout.
# Requires merchant approval, an existing Stripe Price ID and verified webhook.
# STRIPE_SECRET_KEY=
# STRIPE_SERVICE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_LEDGER_FILE=/data/stripe-membership-ledger.json
#
# NEVER put seed phrases/private keys, payment credentials, or Stripe keys in Git.
# Token deployment is wallet-signed on Sepolia testnet; mainnet is disabled.
